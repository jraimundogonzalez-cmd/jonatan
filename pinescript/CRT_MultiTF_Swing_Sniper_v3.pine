//@version=6
// =============================================================================
// CRT Multi-TF Power of Three — Swing/Sniper Edition (v3)
//
// Basado en v2 del usuario (fix del reset agresivo + TP1/TP2/TP3 escalonados).
// Cambios de v2 a v3:
//
//  1) VALIDACION DURA DE TIMEFRAMES: v2 no comprobaba que HTF > intermedio >
//     entrada. Si el usuario configuraba, por ejemplo, intermedio = 1D con
//     HTF = 4h (invertido) o intermedio = TF de entrada, el script seguia
//     generando señales igualmente sobre una jerarquia sin sentido. Ahora se
//     calcula validTFStack = HTF > intermedio > entrada (en segundos) y se
//     usa como candado unico: si es false, "aligned" nunca es true, no se
//     arma ningun swing y no puede dispararse ninguna señal — con un aviso
//     grande en el grafico y una fila roja en la tabla explicando por que.
//
//  2) FILTRO "SOLO A+": input qualityOnly (activado por defecto). Una
//     ruptura de swing que no llega a A+ sigue "consumiendo" el swing (para
//     no quedar disparando en cada vela mientras el precio siga por encima),
//     pero no genera señal, ni alerta, ni entra en el registro.
//
//  3) AVISO EXPLICITO "SIN HTF CLARO": cuando htfBias == 0 o no hay
//     alineacion con el intermedio, la fila de estado lo dice en texto,
//     con fondo de aviso, para no confundirlo nunca con una señal operable.
//
//  4) DISEÑO VISUAL NUEVO (ver diseño acordado): sin cajas de rango
//     translucidas por defecto; marcador de triangulo (direccion) +
//     raya corta con etiqueta numerica en cada nivel (Entrada/SL/TP1/TP2/
//     TP3) + tarjeta compacta junto a la señal con los 5 precios en el
//     mismo orden que el eje de precio. Rojo = riesgo (SL) y verde =
//     objetivo (TP) siempre, sea COMPRA o VENTA — el color de riesgo/premio
//     no cambia con la direccion, solo el triangulo y el encabezado de la
//     tarjeta cambian de color segun COMPRA/VENTA.
//
// La logica de deteccion (manipulacion + alineacion + power of three) es
// la misma que v2: rango HTF/intermedio via request.security() con
// lookahead_off, señal confirmada solo con barstate.isconfirmed (cero
// repintado). Ejecutar siempre en el grafico del TF de entrada.
// =============================================================================
indicator("CRT Multi-TF Swing/Sniper v3", overlay = true, max_lines_count = 300, max_labels_count = 300, max_boxes_count = 50)

// ------------------------------- INPUTS -------------------------------------
grpTF = "Timeframes"
htfTF = input.timeframe("D", "HTF (rango madre / sesgo)", group = grpTF, tooltip = "SWING: 1D (con entrada 1h). SNIPER: 4h (con entrada 15m).")
midTF = input.timeframe("240", "TF intermedio (estructura)", group = grpTF, tooltip = "SWING: 240 (4h). SNIPER: 60 (1h). Debe ser menor que el HTF y mayor que el TF de entrada (el del grafico) — si no, el script bloquea todas las señales.")
swingLen = input.int(2, "Pivote de entrada: velas a cada lado", minval = 1, group = grpTF, tooltip = "El grafico debe estar en el TF de entrada (1h para swing, 15m para sniper).")

grpManip = "Manipulacion / ATR"
atrLen = input.int(14, "Longitud ATR", minval = 1, group = grpManip)
manipMinATR_HTF = input.float(0.30, "Penetracion minima HTF (x ATR HTF)", minval = 0.0, step = 0.05, group = grpManip, tooltip = "Subido de 0.20 (v2) a 0.30 como punto de partida mas exigente. Compara contra 0.20/0.40 con el Strategy Tester, no lo des por optimo.")
manipMinATR_Mid = input.float(0.30, "Penetracion minima TF intermedio (x ATR intermedio)", minval = 0.0, step = 0.05, group = grpManip)
qualityMult = input.float(1.5, "Umbral para calidad A+ (x del minimo exigido)", minval = 1.0, step = 0.1, group = grpManip)
qualityOnly = input.bool(true, "Descartar señales B (solo A+)", group = grpManip, tooltip = "Con esto activado, una ruptura que no llegue a A+ no genera señal, alerta ni registro — pero sigue consumiendo el swing para no repetir aviso cada vela.")

grpRisk = "Gestion (SL / TP escalonado)"
slBufferMult = input.float(0.25, "Buffer de SL (x ATR entrada)", minval = 0.0, step = 0.05, group = grpRisk)
tp1Split = input.float(0.33, "TP1 (fraccion de la distancia al extremo HTF)", minval = 0.05, maxval = 0.95, step = 0.01, group = grpRisk, tooltip = "TP1/TP2/TP3 ya no salen de tres timeframes sueltos (podian no tener relacion entre si y quedar por detras del precio). Ahora son fracciones de la distancia entre la entrada y el extremo opuesto del rango HTF: por construccion, TP1 < TP2 < TP3 y los tres estan siempre por delante del precio.")
tp2Split = input.float(0.66, "TP2 (fraccion de la distancia al extremo HTF)", minval = 0.06, maxval = 0.98, step = 0.01, group = grpRisk)

grpVis = "Visual"
showRanges = input.bool(false, "Dibujar rango HTF / intermedio (depuracion)", group = grpVis)
showStats = input.bool(true, "Mostrar panel de estado", group = grpVis)

// ------------------------------- Paleta -------------------------------------
colLong    = color.rgb(39, 208, 147)   // COMPRA / objetivos (TP) — siempre verde
colShort   = color.rgb(255, 92, 108)   // VENTA / riesgo (SL) — siempre coral
colWarn    = color.rgb(245, 166, 35)   // NEUTRO / sin HTF claro / config invalida
colNeutral = color.rgb(231, 237, 243)  // nivel de entrada

// ------------------------------- Validacion dura de la escalera TF -----------
htfSeconds   = timeframe.in_seconds(htfTF)
midSeconds   = timeframe.in_seconds(midTF)
entrySeconds = timeframe.in_seconds(timeframe.period)
bool validTFStack = htfSeconds > midSeconds and midSeconds > entrySeconds

// ------------------------------- HTF: rango y sesgo --------------------------
[htfHighC, htfLowC, htfCloseC, htfHighP, htfLowP, htfTimeC, htfATR] = request.security(
     syminfo.tickerid, htfTF,
     [high[1], low[1], close[1], high[2], low[2], time[1], ta.atr(atrLen)[1]],
     lookahead = barmerge.lookahead_off)

newHTFBar = ta.change(htfTimeC) != 0

var int   htfBias          = 0
var float htfManipExtreme  = na
var float htfTargetExtreme = na
var float htfRangeHigh     = na
var float htfRangeLow      = na
var float htfManipStrength = na
var box   htfBox           = na

// ------------------------------- TF intermedio: rango y sesgo ----------------
[midHighC, midLowC, midCloseC, midHighP, midLowP, midTimeC, midATR] = request.security(
     syminfo.tickerid, midTF,
     [high[1], low[1], close[1], high[2], low[2], time[1], ta.atr(atrLen)[1]],
     lookahead = barmerge.lookahead_off)

newMidBar = ta.change(midTimeC) != 0

var int   midBias          = 0
var float midManipExtreme  = na
var float midTargetExtreme = na
var float midManipStrength = na
var box   midBox           = na

var int alignedSinceBar = na

// ------------------------------- Entrada (TF de grafico) ---------------------
var float lastSwingHigh    = na
var int   lastSwingHighBar = na
var bool  swingHighUsed    = true
var float pullbackLow      = na

var float lastSwingLow     = na
var int   lastSwingLowBar  = na
var bool  swingLowUsed     = true
var float pullbackHigh     = na

atrEntry = ta.atr(atrLen)

// -------- 1) Nuevo cierre HTF: recalcular sesgo, RESET SOLO SI CAMBIA -------
if newHTFBar
    bool bullSweepHTF = (htfLowC < htfLowP - manipMinATR_HTF * htfATR) and (htfCloseC > htfLowP)
    bool bearSweepHTF = (htfHighC > htfHighP + manipMinATR_HTF * htfATR) and (htfCloseC < htfHighP)
    int detectedHtfBias = bullSweepHTF and not bearSweepHTF ? 1 : (bearSweepHTF and not bullSweepHTF ? -1 : 0)
    htfRangeHigh := htfHighP
    htfRangeLow  := htfLowP

    if detectedHtfBias != 0 and detectedHtfBias != htfBias
        htfBias := detectedHtfBias
        htfManipExtreme := detectedHtfBias == 1 ? htfLowC : htfHighC
        htfTargetExtreme := detectedHtfBias == 1 ? htfHighP : htfLowP
        htfManipStrength := detectedHtfBias == 1 ? (htfLowP - htfLowC) / (manipMinATR_HTF * htfATR) : (htfHighC - htfHighP) / (manipMinATR_HTF * htfATR)
        midBias := 0
        midManipExtreme := na
        midTargetExtreme := na
        alignedSinceBar := na
        lastSwingHigh := na
        lastSwingLow := na
        swingHighUsed := true
        swingLowUsed := true
    else if detectedHtfBias != 0 and detectedHtfBias == htfBias
        float newManipExtreme = detectedHtfBias == 1 ? htfLowC : htfHighC
        float newManipStrength = detectedHtfBias == 1 ? (htfLowP - htfLowC) / (manipMinATR_HTF * htfATR) : (htfHighC - htfHighP) / (manipMinATR_HTF * htfATR)
        htfTargetExtreme := detectedHtfBias == 1 ? htfHighP : htfLowP
        if newManipStrength > htfManipStrength
            htfManipExtreme := newManipExtreme
            htfManipStrength := newManipStrength

    if showRanges
        box.delete(htfBox)
        htfBox := na
        if htfBias != 0
            htfBox := box.new(bar_index, htfRangeHigh, bar_index, htfRangeLow,
                 border_color = color.new(htfBias == 1 ? colLong : colShort, 55), bgcolor = color.new(color.black, 100),
                 border_width = 1, extend = extend.right, xloc = xloc.bar_index)

// -------- 2) Nuevo cierre TF intermedio: mismo criterio, y alineacion --------
if newMidBar
    bool bullSweepMid = (midLowC < midLowP - manipMinATR_Mid * midATR) and (midCloseC > midLowP)
    bool bearSweepMid = (midHighC > midHighP + manipMinATR_Mid * midATR) and (midCloseC < midHighP)
    int detectedMidBias = bullSweepMid and not bearSweepMid ? 1 : (bearSweepMid and not bullSweepMid ? -1 : 0)

    if detectedMidBias != 0 and detectedMidBias != midBias
        midBias := detectedMidBias
        midManipExtreme := detectedMidBias == 1 ? midLowC : midHighC
        midTargetExtreme := detectedMidBias == 1 ? midHighP : midLowP
        midManipStrength := detectedMidBias == 1 ? (midLowP - midLowC) / (manipMinATR_Mid * midATR) : (midHighC - midHighP) / (manipMinATR_Mid * midATR)
    else if detectedMidBias != 0 and detectedMidBias == midBias
        float newMidManipExtreme = detectedMidBias == 1 ? midLowC : midHighC
        float newMidManipStrength = detectedMidBias == 1 ? (midLowP - midLowC) / (manipMinATR_Mid * midATR) : (midHighC - midHighP) / (manipMinATR_Mid * midATR)
        midTargetExtreme := detectedMidBias == 1 ? midHighP : midLowP
        if newMidManipStrength > midManipStrength
            midManipExtreme := newMidManipExtreme
            midManipStrength := newMidManipStrength

    bool alignedNowRaw = validTFStack and htfBias != 0 and midBias == htfBias
    if alignedNowRaw and na(alignedSinceBar)
        alignedSinceBar := bar_index
        lastSwingHigh := na
        lastSwingLow := na
        swingHighUsed := true
        swingLowUsed := true
    else if not alignedNowRaw
        alignedSinceBar := na

    if showRanges
        box.delete(midBox)
        midBox := na
        if midBias != 0
            midBox := box.new(bar_index, midHighP, bar_index, midLowP,
                 border_color = color.new(midBias == 1 ? colLong : colShort, 55), bgcolor = color.new(color.black, 100),
                 border_width = 1, extend = extend.right, xloc = xloc.bar_index)

// candado unico: sin escalera de TF valida, jamas hay alineacion
bool aligned = validTFStack and htfBias != 0 and midBias == htfBias and not na(alignedSinceBar)

// -------- 3) Pivotes de entrada (objetivos, N velas a cada lado) -------------
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

bool justArmedHigh = false
if not na(ph)
    int peakBar = bar_index - swingLen
    if aligned and htfBias == 1 and peakBar >= alignedSinceBar
        lastSwingHigh := ph
        lastSwingHighBar := peakBar
        swingHighUsed := false
        pullbackLow := ta.lowest(low, swingLen)
        justArmedHigh := true
if not justArmedHigh and not na(lastSwingHigh) and not swingHighUsed
    pullbackLow := math.min(pullbackLow, low)

bool justArmedLow = false
if not na(pl)
    int troughBar = bar_index - swingLen
    if aligned and htfBias == -1 and troughBar >= alignedSinceBar
        lastSwingLow := pl
        lastSwingLowBar := troughBar
        swingLowUsed := false
        pullbackHigh := ta.highest(high, swingLen)
        justArmedLow := true
if not justArmedLow and not na(lastSwingLow) and not swingLowUsed
    pullbackHigh := math.max(pullbackHigh, high)

// -------- 4) Gatillo de entrada: ruptura del swing, solo en vela cerrada -----
// El swing SIEMPRE se consume al romperse (evita spam), pero solo se
// convierte en señal si pasa el filtro de calidad (qualityOnly).
bool longTrigger  = false
bool shortTrigger = false
float entryPrice = na
float slPrice = na
float tp1Price = na
float tp2Price = na
float tp3Price = na
string quality = na

if barstate.isconfirmed
    if aligned and htfBias == 1 and not swingHighUsed and not na(lastSwingHigh) and lastSwingHighBar >= alignedSinceBar
        if close > lastSwingHigh and not na(htfManipExtreme) and pullbackLow > htfManipExtreme
            string qLong = (htfManipStrength >= qualityMult and midManipStrength >= qualityMult) ? "A+" : "B"
            bool passesLong = not qualityOnly or qLong == "A+"
            swingHighUsed := true
            // TP1/TP2/TP3 son fracciones de la distancia entre la entrada y
            // htfTargetExtreme (extremo opuesto del rango HTF) — por
            // construccion quedan ordenados TP1 < TP2 < TP3 y siempre por
            // delante del precio, salvo que el precio ya haya superado el
            // rango HTF entero (caso raro, se descarta si pasa).
            float distLong = htfTargetExtreme - close
            float tp1CandLong = close + distLong * tp1Split
            float tp2CandLong = close + distLong * tp2Split
            float tp3CandLong = htfTargetExtreme
            bool tpValidLong = distLong > 0
            if passesLong and tpValidLong
                longTrigger := true
                entryPrice := close
                slPrice := pullbackLow - atrEntry * slBufferMult
                tp1Price := tp1CandLong
                tp2Price := tp2CandLong
                tp3Price := tp3CandLong
                quality := qLong
    if aligned and htfBias == -1 and not swingLowUsed and not na(lastSwingLow) and lastSwingLowBar >= alignedSinceBar
        if close < lastSwingLow and not na(htfManipExtreme) and pullbackHigh < htfManipExtreme
            string qShort = (htfManipStrength >= qualityMult and midManipStrength >= qualityMult) ? "A+" : "B"
            bool passesShort = not qualityOnly or qShort == "A+"
            swingLowUsed := true
            float distShort = close - htfTargetExtreme
            float tp1CandShort = close - distShort * tp1Split
            float tp2CandShort = close - distShort * tp2Split
            float tp3CandShort = htfTargetExtreme
            bool tpValidShort = distShort > 0
            if passesShort and tpValidShort
                shortTrigger := true
                entryPrice := close
                slPrice := pullbackHigh + atrEntry * slBufferMult
                tp1Price := tp1CandShort
                tp2Price := tp2CandShort
                tp3Price := tp3CandShort
                quality := qShort

// ------------------------------- Alerta sonora con mensaje dinamico -----------
if longTrigger or shortTrigger
    string alertMsg = (longTrigger ? "COMPRA" : "VENTA") + " " + syminfo.ticker +
         " | Entrada " + str.tostring(entryPrice, format.mintick) +
         " | SL " + str.tostring(slPrice, format.mintick) +
         " | TP1 " + str.tostring(tp1Price, format.mintick) +
         " | TP2 " + str.tostring(tp2Price, format.mintick) +
         " | TP3 " + str.tostring(tp3Price, format.mintick) +
         " | Calidad " + quality
    alert(alertMsg, alert.freq_once_per_bar_close)

// ------------------------------- Visual: diseño acordado ----------------------
// Cada nivel: raya corta + etiqueta numerica en el precio exacto. Rojo =
// riesgo (SL), verde = objetivo (TP), sin importar si es COMPRA o VENTA.
// Ademas, una tarjeta unica junto a la señal con los 5 precios en el mismo
// orden que el eje vertical (arriba = precio mas alto).
drawLevel(float y, string txt, color col, int x1, int x2) =>
    line.new(x1, y, x2, y, color = col, width = 1)
    label.new(x2, y, txt, style = label.style_label_left, color = color.new(col, 82), textcolor = col, size = size.tiny)

if longTrigger
    label.new(bar_index, low, "", style = label.style_triangleup, color = colLong, size = size.small, yloc = yloc.belowbar)
    int x2 = bar_index + 6
    drawLevel(tp3Price, "TP3 " + str.tostring(tp3Price, format.mintick), colLong, bar_index, x2)
    drawLevel(tp2Price, "TP2 " + str.tostring(tp2Price, format.mintick), colLong, bar_index, x2)
    drawLevel(tp1Price, "TP1 " + str.tostring(tp1Price, format.mintick), colLong, bar_index, x2)
    drawLevel(entryPrice, "Entr " + str.tostring(entryPrice, format.mintick), colNeutral, bar_index, x2)
    drawLevel(slPrice, "SL " + str.tostring(slPrice, format.mintick), colShort, bar_index, x2)
    string cardTextL = "▲ COMPRA · " + quality +
         "\nTP3  " + str.tostring(tp3Price, format.mintick) +
         "\nTP2  " + str.tostring(tp2Price, format.mintick) +
         "\nTP1  " + str.tostring(tp1Price, format.mintick) +
         "\nEntr " + str.tostring(entryPrice, format.mintick) +
         "\nSL   " + str.tostring(slPrice, format.mintick)
    label.new(bar_index + 9, entryPrice, cardTextL, style = label.style_label_left, color = color.new(colLong, 78), textcolor = color.white, size = size.small)

if shortTrigger
    label.new(bar_index, high, "", style = label.style_triangledown, color = colShort, size = size.small, yloc = yloc.abovebar)
    int x2s = bar_index + 6
    drawLevel(slPrice, "SL " + str.tostring(slPrice, format.mintick), colShort, bar_index, x2s)
    drawLevel(entryPrice, "Entr " + str.tostring(entryPrice, format.mintick), colNeutral, bar_index, x2s)
    drawLevel(tp1Price, "TP1 " + str.tostring(tp1Price, format.mintick), colLong, bar_index, x2s)
    drawLevel(tp2Price, "TP2 " + str.tostring(tp2Price, format.mintick), colLong, bar_index, x2s)
    drawLevel(tp3Price, "TP3 " + str.tostring(tp3Price, format.mintick), colLong, bar_index, x2s)
    string cardTextS = "▼ VENTA · " + quality +
         "\nSL   " + str.tostring(slPrice, format.mintick) +
         "\nEntr " + str.tostring(entryPrice, format.mintick) +
         "\nTP1  " + str.tostring(tp1Price, format.mintick) +
         "\nTP2  " + str.tostring(tp2Price, format.mintick) +
         "\nTP3  " + str.tostring(tp3Price, format.mintick)
    label.new(bar_index + 9, entryPrice, cardTextS, style = label.style_label_left, color = color.new(colShort, 78), textcolor = color.white, size = size.small)

// ------------------------------- Registro para validar efectividad -----------
var array<int>    logBar     = array.new<int>()
var array<int>    logDir     = array.new<int>()
var array<float>  logEntry   = array.new<float>()
var array<float>  logSL      = array.new<float>()
var array<float>  logTP3     = array.new<float>()
var array<string> logQuality = array.new<string>()
var array<string> logStatus  = array.new<string>() // "OPEN" | "TP3" | "SL"
var array<line>   logLineSL  = array.new<line>()
var array<line>   logLineTP  = array.new<line>()

if longTrigger or shortTrigger
    array.push(logBar, bar_index)
    array.push(logDir, longTrigger ? 1 : -1)
    array.push(logEntry, entryPrice)
    array.push(logSL, slPrice)
    array.push(logTP3, tp3Price)
    array.push(logQuality, quality)
    array.push(logStatus, "OPEN")
    array.push(logLineSL, line.new(bar_index, slPrice, bar_index, slPrice, color = color.new(colShort, 20)))
    array.push(logLineTP, line.new(bar_index, tp3Price, bar_index, tp3Price, color = color.new(colLong, 20)))

if barstate.isconfirmed and array.size(logStatus) > 0
    for i = 0 to array.size(logStatus) - 1
        if array.get(logStatus, i) == "OPEN"
            int dir = array.get(logDir, i)
            float sl = array.get(logSL, i)
            float tp = array.get(logTP3, i)
            line.set_x2(array.get(logLineSL, i), bar_index)
            line.set_x2(array.get(logLineTP, i), bar_index)
            if dir == 1
                if low <= sl
                    array.set(logStatus, i, "SL")
                else if high >= tp
                    array.set(logStatus, i, "TP3")
            else
                if high >= sl
                    array.set(logStatus, i, "SL")
                else if low <= tp
                    array.set(logStatus, i, "TP3")

// ------------------------------- Panel de estado -------------------------------
if showStats and barstate.islast
    var table statsTable = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 70), border_width = 1)

    string htfTxt = htfBias == 1 ? "ALCISTA" : htfBias == -1 ? "BAJISTA" : "NEUTRO - NO OPERAR"
    color  htfBg  = htfBias == 1 ? color.new(colLong, 65) : htfBias == -1 ? color.new(colShort, 65) : color.new(colWarn, 55)
    string midTxt = midBias == 1 ? "ALCISTA" : midBias == -1 ? "BAJISTA" : "NEUTRO"
    color  midBg  = midBias == 1 ? color.new(colLong, 65) : midBias == -1 ? color.new(colShort, 65) : color.new(colWarn, 55)
    string alTxt  = aligned ? "SI" : "NO"
    color  alBg   = aligned ? color.new(colLong, 65) : color.new(colWarn, 55)

    table.cell(statsTable, 0, 0, "HTF", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 0, htfTxt, text_color = color.white, bgcolor = htfBg, text_size = size.small)
    table.cell(statsTable, 0, 1, "Intermedio", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 1, midTxt, text_color = color.white, bgcolor = midBg, text_size = size.small)
    table.cell(statsTable, 0, 2, "Alineado", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 2, alTxt, text_color = color.white, bgcolor = alBg, text_size = size.small)

    int total = array.size(logStatus)
    int wins = 0
    int losses = 0
    int openCount = 0
    if total > 0
        for i = 0 to total - 1
            string st = array.get(logStatus, i)
            if st == "TP3"
                wins += 1
            else if st == "SL"
                losses += 1
            else
                openCount += 1
    int closed = wins + losses
    float winRate = closed > 0 ? (wins / closed) * 100.0 : na

    table.cell(statsTable, 0, 3, "Señales (TP3/SL/Abiertas)", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 3, str.tostring(total) + " (" + str.tostring(wins) + "/" + str.tostring(losses) + "/" + str.tostring(openCount) + ")", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 0, 4, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 4, na(winRate) ? "-" : str.tostring(winRate, "#.#") + "%", text_color = color.white, text_size = size.small)

// Aviso grande y persistente si la escalera de TF no tiene sentido —
// se actualiza en el mismo objeto en vez de crear uno nuevo cada tick.
var label tfWarnLabel = na
if barstate.islast
    if not validTFStack
        if na(tfWarnLabel)
            tfWarnLabel := label.new(bar_index, high, "", style = label.style_label_down, color = color.new(colWarn, 5), textcolor = color.black, size = size.normal)
        label.set_xy(tfWarnLabel, bar_index, high)
        label.set_text(tfWarnLabel, "⚠ CONFIG TF INVALIDA: intermedio debe ser < HTF y > TF de entrada")
    else if not na(tfWarnLabel)
        label.delete(tfWarnLabel)
        tfWarnLabel := na

// ------------------------------- Alertas --------------------------------------
alertcondition(longTrigger, title = "CRT LONG", message = "CRT Swing/Sniper: entrada LONG")
alertcondition(shortTrigger, title = "CRT SHORT", message = "CRT Swing/Sniper: entrada SHORT")
