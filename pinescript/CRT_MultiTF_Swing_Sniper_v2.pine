//@version=6
// =============================================================================
// CRT Multi-TF Power of Three — Swing/Sniper Edition (v2)
//
// Basado en "CRT Multi-TF Power of Three" del usuario. Cambios respecto al
// original:
//
//  1) FIX del "reset agresivo": en el original, el estado de alineacion y
//     de swings se borraba en CADA cierre de vela del HTF, aunque el sesgo
//     no cambiara. Eso obligaba a que manipulacion -> alineacion -> pivote
//     -> ruptura ocurriera dentro de una sola vela del HTF, lo que dejaba
//     el numero de señales practicamente en cero en cualquier timeframe
//     (backtest: 5m=2 señales en ~2 meses, 15m/30m/1h=0 señales en 9
//     meses-3,5 años). Ahora el progreso de alineacion/swing SOLO se borra
//     cuando el sesgo del HTF cambia de direccion de verdad.
//
//  2) Objetivos escalonados TP1/TP2/TP3 en rangos de N horas configurables
//     (por defecto 4h / 6h / 8h) en vez de un unico TP al extremo del HTF.
//
//  3) Pensado para dos configuraciones de uso (cambia los inputs, el
//     codigo es el mismo):
//       - SWING  -> TF de entrada (grafico) = 1h,  TF intermedio = 4h,  HTF = 1D
//       - SNIPER -> TF de entrada (grafico) = 15m, TF intermedio = 1h,  HTF = 4h
//     (el "TF de entrada" siempre es el timeframe del propio grafico; para
//     pasar de swing a sniper solo hay que cambiar el timeframe del
//     grafico Y los inputs "TF intermedio"/"HTF" a los valores de arriba)
//
// Ejecutar SIEMPRE en el grafico del TF de entrada. HTF y TF intermedio se
// leen via request.security() con lookahead_off, y solo se re-evaluan en
// el cierre de su propia vela: cero repintado.
// =============================================================================
indicator("CRT Multi-TF Power of Three - Swing-Sniper v2", overlay = true, max_lines_count = 300, max_labels_count = 300, max_boxes_count = 50)

// ------------------------------- INPUTS -------------------------------------
grpTF = "Timeframes"
htfTF = input.timeframe("D", "HTF (rango madre / sesgo)", group = grpTF, tooltip = "SWING: 1D (con entrada 1h). SNIPER: 4h (con entrada 15m).")
midTF = input.timeframe("240", "TF intermedio (estructura)", group = grpTF, tooltip = "SWING: 240 (4h). SNIPER: 60 (1h).")
swingLen = input.int(2, "Pivote de entrada: velas a cada lado", minval = 1, group = grpTF, tooltip = "El grafico debe estar en el TF de entrada (1h para swing, 15m para sniper).")

grpManip = "Manipulacion / ATR"
atrLen = input.int(14, "Longitud ATR", minval = 1, group = grpManip)
manipMinATR_HTF = input.float(0.20, "Penetracion minima HTF (x ATR HTF)", minval = 0.0, step = 0.05, group = grpManip)
manipMinATR_Mid = input.float(0.20, "Penetracion minima TF intermedio (x ATR intermedio)", minval = 0.0, step = 0.05, group = grpManip)
qualityMult = input.float(1.5, "Umbral para calidad A+ (x del minimo exigido)", minval = 1.0, step = 0.1, group = grpManip)

grpRisk = "Gestion (SL / TP escalonado)"
slBufferMult = input.float(0.25, "Buffer de SL (x ATR entrada)", minval = 0.0, step = 0.05, group = grpRisk)
tp1TF = input.timeframe("240", "TP1 - rango de", group = grpRisk)
tp2TF = input.timeframe("360", "TP2 - rango de", group = grpRisk)
tp3TF = input.timeframe("480", "TP3 - rango de", group = grpRisk)

grpVis = "Visual"
showRanges = input.bool(true, "Dibujar rango HTF / intermedio", group = grpVis)
showStats = input.bool(true, "Mostrar tabla de estadisticas", group = grpVis)

// ------------------------------- HTF: rango y sesgo --------------------------
[htfHighC, htfLowC, htfCloseC, htfHighP, htfLowP, htfTimeC, htfATR] = request.security(
     syminfo.tickerid, htfTF,
     [high[1], low[1], close[1], high[2], low[2], time[1], ta.atr(atrLen)[1]],
     lookahead = barmerge.lookahead_off)

newHTFBar = ta.change(htfTimeC) != 0

var int htfBias = 0
var float htfManipExtreme = na
var float htfTargetExtreme = na
var float htfRangeHigh = na
var float htfRangeLow = na
var float htfManipStrength = na
var box htfBox = na

// ------------------------------- TF intermedio: rango y sesgo ----------------
[midHighC, midLowC, midCloseC, midHighP, midLowP, midTimeC, midATR] = request.security(
     syminfo.tickerid, midTF,
     [high[1], low[1], close[1], high[2], low[2], time[1], ta.atr(atrLen)[1]],
     lookahead = barmerge.lookahead_off)

newMidBar = ta.change(midTimeC) != 0

var int midBias = 0
var float midManipExtreme = na
var float midTargetExtreme = na
var float midManipStrength = na
var box midBox = na

var int alignedSinceBar = na

// ------------------------------- Objetivos escalonados (4h/6h/8h) ------------
[tp1HighP, tp1LowP] = request.security(syminfo.tickerid, tp1TF, [high[1], low[1]], lookahead = barmerge.lookahead_off)
[tp2HighP, tp2LowP] = request.security(syminfo.tickerid, tp2TF, [high[1], low[1]], lookahead = barmerge.lookahead_off)
[tp3HighP, tp3LowP] = request.security(syminfo.tickerid, tp3TF, [high[1], low[1]], lookahead = barmerge.lookahead_off)

// ------------------------------- Entrada (TF de grafico) ---------------------
var float lastSwingHigh = na
var int lastSwingHighBar = na
var bool swingHighUsed = true
var float pullbackLow = na

var float lastSwingLow = na
var int lastSwingLowBar = na
var bool swingLowUsed = true
var float pullbackHigh = na

atrEntry = ta.atr(atrLen)

// -------- 1) Nuevo cierre HTF: recalcular sesgo, RESET SOLO SI CAMBIA -------
if newHTFBar
    bool bullSweepHTF = (htfLowC < htfLowP - manipMinATR_HTF * htfATR) and (htfCloseC > htfLowP)
    bool bearSweepHTF = (htfHighC > htfHighP + manipMinATR_HTF * htfATR) and (htfCloseC < htfHighP)
    int detectedHtfBias = bullSweepHTF and not bearSweepHTF ? 1 : (bearSweepHTF and not bullSweepHTF ? -1 : 0)
    htfRangeHigh := htfHighP
    htfRangeLow := htfLowP

    if detectedHtfBias != 0 and detectedHtfBias != htfBias
        // -------- cambio REAL de sesgo: aqui si se borra el progreso ---------
        htfBias := detectedHtfBias
        htfManipExtreme := detectedHtfBias == 1 ? htfLowC : htfHighC
        htfTargetExtreme := detectedHtfBias == 1 ? htfHighP : htfLowP
        htfManipStrength := detectedHtfBias == 1 ? (htfLowP - htfLowC) / (manipMinATR_HTF * htfATR) : (htfHighC - htfHighP) / (manipMinATR_HTF * htfATR)
        midBias := 0
        midManipExtreme := na
        midTargetExtreme := na
        alignedSinceBar := na
        lastSwingHigh := na
        lastSwingLow := na
        swingHighUsed := true
        swingLowUsed := true
    else if detectedHtfBias != 0 and detectedHtfBias == htfBias
        // -------- mismo sesgo confirmado de nuevo: refresca SIN borrar -------
        float newManipExtreme = detectedHtfBias == 1 ? htfLowC : htfHighC
        float newManipStrength = detectedHtfBias == 1 ? (htfLowP - htfLowC) / (manipMinATR_HTF * htfATR) : (htfHighC - htfHighP) / (manipMinATR_HTF * htfATR)
        htfTargetExtreme := detectedHtfBias == 1 ? htfHighP : htfLowP
        if newManipStrength > htfManipStrength
            htfManipExtreme := newManipExtreme
            htfManipStrength := newManipStrength
    // si detectedHtfBias == 0 (vela HTF sin barrido claro) no se toca nada:
    // se conserva el ultimo sesgo/objetivo valido y todo el progreso ya hecho

    if showRanges
        box.delete(htfBox)
        htfBox := na
        if htfBias != 0
            htfBox := box.new(bar_index, htfRangeHigh, bar_index, htfRangeLow,
                 border_color = color.new(htfBias == 1 ? color.green : color.red, 60),
                 bgcolor = color.new(htfBias == 1 ? color.green : color.red, 90),
                 extend = extend.right, xloc = xloc.bar_index)

// -------- 2) Nuevo cierre TF intermedio: mismo criterio, y alineacion --------
if newMidBar
    bool bullSweepMid = (midLowC < midLowP - manipMinATR_Mid * midATR) and (midCloseC > midLowP)
    bool bearSweepMid = (midHighC > midHighP + manipMinATR_Mid * midATR) and (midCloseC < midHighP)
    int detectedMidBias = bullSweepMid and not bearSweepMid ? 1 : (bearSweepMid and not bullSweepMid ? -1 : 0)

    if detectedMidBias != 0 and detectedMidBias != midBias
        midBias := detectedMidBias
        midManipExtreme := detectedMidBias == 1 ? midLowC : midHighC
        midTargetExtreme := detectedMidBias == 1 ? midHighP : midLowP
        midManipStrength := detectedMidBias == 1 ? (midLowP - midLowC) / (manipMinATR_Mid * midATR) : (midHighC - midHighP) / (manipMinATR_Mid * midATR)
    else if detectedMidBias != 0 and detectedMidBias == midBias
        float newMidManipExtreme = detectedMidBias == 1 ? midLowC : midHighC
        float newMidManipStrength = detectedMidBias == 1 ? (midLowP - midLowC) / (manipMinATR_Mid * midATR) : (midHighC - midHighP) / (manipMinATR_Mid * midATR)
        midTargetExtreme := detectedMidBias == 1 ? midHighP : midLowP
        if newMidManipStrength > midManipStrength
            midManipExtreme := newMidManipExtreme
            midManipStrength := newMidManipStrength
    // detectedMidBias == 0 -> se conserva el ultimo midBias valido

    bool alignedNow = htfBias != 0 and midBias == htfBias
    if alignedNow and na(alignedSinceBar)
        alignedSinceBar := bar_index
        lastSwingHigh := na
        lastSwingLow := na
        swingHighUsed := true
        swingLowUsed := true
    else if not alignedNow
        alignedSinceBar := na

    if showRanges
        box.delete(midBox)
        midBox := na
        if midBias != 0
            midBox := box.new(bar_index, midHighP, bar_index, midLowP,
                 border_color = color.new(midBias == 1 ? color.green : color.red, 60),
                 bgcolor = color.new(midBias == 1 ? color.green : color.red, 90),
                 extend = extend.right, xloc = xloc.bar_index)

bool aligned = htfBias != 0 and midBias == htfBias and not na(alignedSinceBar)

// -------- 3) Pivotes de entrada (objetivos, N velas a cada lado) -------------
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

bool justArmedHigh = false
if not na(ph)
    int peakBar = bar_index - swingLen
    if aligned and htfBias == 1 and peakBar >= alignedSinceBar
        lastSwingHigh := ph
        lastSwingHighBar := peakBar
        swingHighUsed := false
        pullbackLow := ta.lowest(low, swingLen)
        justArmedHigh := true
if not justArmedHigh and not na(lastSwingHigh) and not swingHighUsed
    pullbackLow := math.min(pullbackLow, low)

bool justArmedLow = false
if not na(pl)
    int troughBar = bar_index - swingLen
    if aligned and htfBias == -1 and troughBar >= alignedSinceBar
        lastSwingLow := pl
        lastSwingLowBar := troughBar
        swingLowUsed := false
        pullbackHigh := ta.highest(high, swingLen)
        justArmedLow := true
if not justArmedLow and not na(lastSwingLow) and not swingLowUsed
    pullbackHigh := math.max(pullbackHigh, high)

// -------- 4) Gatillo de entrada: ruptura del swing, solo en vela cerrada -----
bool longTrigger = false
bool shortTrigger = false
float entryPrice = na
float slPrice = na
float tp1Price = na
float tp2Price = na
float tp3Price = na
string quality = na

if barstate.isconfirmed
    if aligned and htfBias == 1 and not swingHighUsed and not na(lastSwingHigh) and lastSwingHighBar >= alignedSinceBar
        if close > lastSwingHigh and not na(htfManipExtreme) and pullbackLow > htfManipExtreme
            longTrigger := true
            entryPrice := close
            slPrice := pullbackLow - atrEntry * slBufferMult
            tp1Price := tp1HighP
            tp2Price := tp2HighP
            tp3Price := tp3HighP
            quality := (htfManipStrength >= qualityMult and midManipStrength >= qualityMult) ? "A+" : "B"
            swingHighUsed := true
    if aligned and htfBias == -1 and not swingLowUsed and not na(lastSwingLow) and lastSwingLowBar >= alignedSinceBar
        if close < lastSwingLow and not na(htfManipExtreme) and pullbackHigh < htfManipExtreme
            shortTrigger := true
            entryPrice := close
            slPrice := pullbackHigh + atrEntry * slBufferMult
            tp1Price := tp1LowP
            tp2Price := tp2LowP
            tp3Price := tp3LowP
            quality := (htfManipStrength >= qualityMult and midManipStrength >= qualityMult) ? "A+" : "B"
            swingLowUsed := true

// ------------------------------- Alerta sonora con mensaje dinamico -----------
if longTrigger or shortTrigger
    string alertMsg = (longTrigger ? "COMPRA" : "VENTA") + " " + syminfo.ticker +
         " | Entrada " + str.tostring(entryPrice, format.mintick) +
         " | SL " + str.tostring(slPrice, format.mintick) +
         " | TP1 " + str.tostring(tp1Price, format.mintick) +
         " | TP2 " + str.tostring(tp2Price, format.mintick) +
         " | TP3 " + str.tostring(tp3Price, format.mintick) +
         " | Calidad " + quality
    alert(alertMsg, alert.freq_once_per_bar_close)

// ------------------------------- Visual: etiquetas y niveles ------------------
if longTrigger
    label.new(bar_index, low, "LONG " + quality, style = label.style_label_up,
         color = quality == "A+" ? color.new(color.green, 0) : color.new(color.green, 55),
         textcolor = color.white, size = size.small, yloc = yloc.belowbar)
    line.new(bar_index, entryPrice, bar_index + 5, entryPrice, color = color.new(color.blue, 30), style = line.style_dashed)
    line.new(bar_index, tp1Price, bar_index + 5, tp1Price, color = color.new(color.lime, 40), style = line.style_dotted)
    line.new(bar_index, tp2Price, bar_index + 5, tp2Price, color = color.new(color.lime, 20), style = line.style_dotted)
    line.new(bar_index, tp3Price, bar_index + 5, tp3Price, color = color.new(color.lime, 0), style = line.style_dotted)
if shortTrigger
    label.new(bar_index, high, "SHORT " + quality, style = label.style_label_down,
         color = quality == "A+" ? color.new(color.red, 0) : color.new(color.red, 55),
         textcolor = color.white, size = size.small, yloc = yloc.abovebar)
    line.new(bar_index, entryPrice, bar_index + 5, entryPrice, color = color.new(color.blue, 30), style = line.style_dashed)
    line.new(bar_index, tp1Price, bar_index + 5, tp1Price, color = color.new(color.lime, 40), style = line.style_dotted)
    line.new(bar_index, tp2Price, bar_index + 5, tp2Price, color = color.new(color.lime, 20), style = line.style_dotted)
    line.new(bar_index, tp3Price, bar_index + 5, tp3Price, color = color.new(color.lime, 0), style = line.style_dotted)

// ------------------------------- Registro para validar efectividad -----------
var array<int> logBar = array.new<int>()
var array<int> logDir = array.new<int>()
var array<float> logEntry = array.new<float>()
var array<float> logSL = array.new<float>()
var array<float> logTP3 = array.new<float>()
var array<string> logQuality = array.new<string>()
var array<string> logStatus = array.new<string>() // "OPEN" | "TP1" | "TP2" | "TP3" | "SL"
var array<line> logLineSL = array.new<line>()
var array<line> logLineTP = array.new<line>()

if longTrigger or shortTrigger
    array.push(logBar, bar_index)
    array.push(logDir, longTrigger ? 1 : -1)
    array.push(logEntry, entryPrice)
    array.push(logSL, slPrice)
    array.push(logTP3, tp3Price)
    array.push(logQuality, quality)
    array.push(logStatus, "OPEN")
    array.push(logLineSL, line.new(bar_index, slPrice, bar_index, slPrice, color = color.new(color.red, 20)))
    array.push(logLineTP, line.new(bar_index, tp3Price, bar_index, tp3Price, color = color.new(color.green, 20)))

if barstate.isconfirmed and array.size(logStatus) > 0
    for i = 0 to array.size(logStatus) - 1
        if array.get(logStatus, i) == "OPEN"
            int dir = array.get(logDir, i)
            float sl = array.get(logSL, i)
            float tp = array.get(logTP3, i)
            line.set_x2(array.get(logLineSL, i), bar_index)
            line.set_x2(array.get(logLineTP, i), bar_index)
            if dir == 1
                if low <= sl
                    array.set(logStatus, i, "SL")
                else if high >= tp
                    array.set(logStatus, i, "TP3")
            else
                if high >= sl
                    array.set(logStatus, i, "SL")
                else if low <= tp
                    array.set(logStatus, i, "TP3")

// ------------------------------- Tabla de estadisticas ------------------------
if showStats and barstate.islast
    var table statsTable = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 75), border_width = 1)
    int total = array.size(logStatus)
    int wins = 0
    int losses = 0
    int openCount = 0
    if total > 0
        for i = 0 to total - 1
            string st = array.get(logStatus, i)
            if st == "TP3"
                wins += 1
            else if st == "SL"
                losses += 1
            else
                openCount += 1
    int closed = wins + losses
    float winRate = closed > 0 ? (wins / closed) : na

    table.cell(statsTable, 0, 0, "Sesgo HTF", text_color = color.white)
    table.cell(statsTable, 1, 0, htfBias == 1 ? "ALCISTA" : htfBias == -1 ? "BAJISTA" : "-", text_color = htfBias == 1 ? color.lime : htfBias == -1 ? color.red : color.gray)
    table.cell(statsTable, 0, 1, "Sesgo intermedio", text_color = color.white)
    table.cell(statsTable, 1, 1, midBias == 1 ? "ALCISTA" : midBias == -1 ? "BAJISTA" : "-", text_color = midBias == 1 ? color.lime : midBias == -1 ? color.red : color.gray)
    table.cell(statsTable, 0, 2, "Alineado", text_color = color.white)
    table.cell(statsTable, 1, 2, aligned ? "SI" : "NO", text_color = aligned ? color.lime : color.gray)
    table.cell(statsTable, 0, 3, "Señales totales", text_color = color.white)
    table.cell(statsTable, 1, 3, str.tostring(total), text_color = color.white)
    table.cell(statsTable, 0, 4, "TP3 / SL / Abiertas", text_color = color.white)
    table.cell(statsTable, 1, 4, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(openCount), text_color = color.white)
    table.cell(statsTable, 0, 5, "Win rate (cerradas)", text_color = color.white)
    table.cell(statsTable, 1, 5, na(winRate) ? "-" : str.tostring(math.round(winRate * 100)) + "%", text_color = color.white)

// ------------------------------- Alertas --------------------------------------
alertcondition(longTrigger, title = "CRT LONG", message = "CRT Swing/Sniper: entrada LONG")
alertcondition(shortTrigger, title = "CRT SHORT", message = "CRT Swing/Sniper: entrada SHORT")
