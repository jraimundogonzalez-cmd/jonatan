//@version=6
//
// CRT Range Engine — Price Map (Fase 1: mapa mecanico de niveles)
// ------------------------------------------------------------------
// Indicador NUEVO e independiente del indicador de entradas CRT.
// Para cada duracion configurada (horaria/diaria/semanal/mensual) dibuja
// el maximo y el minimo de esa ventana ya cerrada: azul = nivel por
// encima del precio actual, rojo = nivel por debajo. Es la Capa 1 (mapa
// mecanico, sin interpretacion) — copia exacta del concepto de tus
// capturas, SIN filtro de distancia: se marca todo, tu decides despues
// que categorias apagar con las casillas.
//
// Reescritura respecto a la version anterior: la primera version usaba
// objetos de linea/etiqueta pre-creados y mutados por referencia dentro
// de una funcion compartida — no pude compilarla yo mismo en este
// entorno (no tengo MetaEditor/Pine Editor aqui) y no dibujaba nada en
// tu grafico. Esta version usa el patron mas simple y mas probado en
// Pine: en cada recalculo de la ultima barra, borra los objetos del
// ciclo anterior y crea los nuevos desde cero — sin funcion compartida,
// sin pre-alocacion, cada categoria con su propio codigo plano. Es mas
// facil de verificar leyendolo y es el patron que usan la mayoria de
// indicadores de niveles publicados en Pine.
//
// Si TAMPOCO aparece nada con esta version: abre el script en el Pine
// Editor (no solo "Añadir al grafico") y mirame exactamente que dice la
// pestaña de errores/consola — sin eso no puedo diagnosticar a ciegas
// mas alla de lo que ya he corregido aqui.
//
// Decisiones que se mantienen:
// 1) "N horas/dias/semanas/meses" = maximo/minimo de las ultimas N velas
//    YA CERRADAS del timeframe base (H1/D1/W1/M1) — no repinta, no usa
//    informacion futura.
// 2) Solo 4 llamadas a request.security() en total (H1/D1/W1/M1) — Pine
//    limita a 40 llamadas por script, no caben 148 (una por duracion).
// 3) Las lineas tienen una longitud visual fija hacia atras (input), no
//    nacen exactamente en el origen real de la ventana — simplificacion
//    deliberada para esta v1.
// 4) SIN fusion automatica de niveles coincidentes en una sola etiqueta
//    combinada todavia — cada duracion tiene su propia etiqueta.

indicator("CRT Range Engine — Price Map", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ------------------------------- Inputs -----------------------------------
grpVis = "Visibilidad por categoria"
showHourly  = input.bool(true,  "Mostrar Horarios (1h-24h)",        group = grpVis)
showDaily   = input.bool(true,  "Mostrar Diarios (1D-60D)",         group = grpVis)
showWeekly  = input.bool(true,  "Mostrar Semanales (1-52 semanas)", group = grpVis)
showMonthly = input.bool(true,  "Mostrar Mensuales (1-12 meses)",   group = grpVis)

grpStyle = "Estilo"
colorUp     = input.color(color.new(color.blue, 0), "Color objetivo alcista (por encima del precio)", group = grpStyle)
colorDown   = input.color(color.new(color.red, 0),  "Color objetivo bajista (por debajo del precio)", group = grpStyle)
lineWidthIn = input.int(1, "Grosor de linea", minval = 1, maxval = 4, group = grpStyle)
lineLenBars = input.int(60, "Longitud visual de las lineas (barras hacia atras)", minval = 5, group = grpStyle)
showLabels  = input.bool(true, "Mostrar etiquetas de duracion", group = grpStyle)
labelSize   = input.string(size.tiny, "Tamano de etiqueta", options = [size.tiny, size.small, size.normal], group = grpStyle)

// ------------------------------- Tamanos de escalera ------------------------
N_HOURLY  = 24
N_DAILY   = 60
N_WEEKLY  = 52
N_MONTHLY = 12

// ------------------------------- Datos base (4 llamadas, no mas) -----------
[h1H, h1L, h1T] = request.security(syminfo.tickerid, "60", [high[1], low[1], time], lookahead = barmerge.lookahead_off)
[d1H, d1L, d1T] = request.security(syminfo.tickerid, "D",  [high[1], low[1], time], lookahead = barmerge.lookahead_off)
[w1H, w1L, w1T] = request.security(syminfo.tickerid, "W",  [high[1], low[1], time], lookahead = barmerge.lookahead_off)
[m1H, m1L, m1T] = request.security(syminfo.tickerid, "M",  [high[1], low[1], time], lookahead = barmerge.lookahead_off)

// ------------------------------- Acumulacion de historicos cerrados --------
var array<float> hHighArr = array.new<float>()
var array<float> hLowArr  = array.new<float>()
var float hLastT = na
if not na(h1T) and (na(hLastT) or h1T != hLastT)
    if not na(h1H)
        array.push(hHighArr, h1H)
        array.push(hLowArr, h1L)
        if array.size(hHighArr) > N_HOURLY
            array.shift(hHighArr)
            array.shift(hLowArr)
    hLastT := h1T

var array<float> dHighArr = array.new<float>()
var array<float> dLowArr  = array.new<float>()
var float dLastT = na
if not na(d1T) and (na(dLastT) or d1T != dLastT)
    if not na(d1H)
        array.push(dHighArr, d1H)
        array.push(dLowArr, d1L)
        if array.size(dHighArr) > N_DAILY
            array.shift(dHighArr)
            array.shift(dLowArr)
    dLastT := d1T

var array<float> wHighArr = array.new<float>()
var array<float> wLowArr  = array.new<float>()
var float wLastT = na
if not na(w1T) and (na(wLastT) or w1T != wLastT)
    if not na(w1H)
        array.push(wHighArr, w1H)
        array.push(wLowArr, w1L)
        if array.size(wHighArr) > N_WEEKLY
            array.shift(wHighArr)
            array.shift(wLowArr)
    wLastT := w1T

var array<float> mHighArr = array.new<float>()
var array<float> mLowArr  = array.new<float>()
var float mLastT = na
if not na(m1T) and (na(mLastT) or m1T != mLastT)
    if not na(m1H)
        array.push(mHighArr, m1H)
        array.push(mLowArr, m1L)
        if array.size(mHighArr) > N_MONTHLY
            array.shift(mHighArr)
            array.shift(mLowArr)
    mLastT := m1T

// ------------------------------- Handles de dibujo (se borran y recrean) ---
var array<line>  hLines = array.new<line>()
var array<label> hLbls  = array.new<label>()
var array<line>  dLines = array.new<line>()
var array<label> dLbls  = array.new<label>()
var array<line>  wLines = array.new<line>()
var array<label> wLbls  = array.new<label>()
var array<line>  mLines = array.new<line>()
var array<label> mLbls  = array.new<label>()

// ------------------------------- Dibujo: solo en la ultima barra -----------
if barstate.islast
    // --- borrar todo lo dibujado en el recalculo anterior ---
    for i = 0 to array.size(hLines) - 1
        line.delete(array.get(hLines, i))
    for i = 0 to array.size(hLbls) - 1
        label.delete(array.get(hLbls, i))
    array.clear(hLines)
    array.clear(hLbls)

    for i = 0 to array.size(dLines) - 1
        line.delete(array.get(dLines, i))
    for i = 0 to array.size(dLbls) - 1
        label.delete(array.get(dLbls, i))
    array.clear(dLines)
    array.clear(dLbls)

    for i = 0 to array.size(wLines) - 1
        line.delete(array.get(wLines, i))
    for i = 0 to array.size(wLbls) - 1
        label.delete(array.get(wLbls, i))
    array.clear(wLines)
    array.clear(wLbls)

    for i = 0 to array.size(mLines) - 1
        line.delete(array.get(mLines, i))
    for i = 0 to array.size(mLbls) - 1
        label.delete(array.get(mLbls, i))
    array.clear(mLines)
    array.clear(mLbls)

    // --- Horarios ---
    if showHourly
        hSz = array.size(hHighArr)
        for n = 1 to N_HOURLY
            if hSz >= n
                hiVal = array.max(array.slice(hHighArr, hSz - n, hSz))
                loVal = array.min(array.slice(hLowArr,  hSz - n, hSz))
                if hiVal > close
                    array.push(hLines, line.new(bar_index - lineLenBars, hiVal, bar_index, hiVal, color = colorUp, width = lineWidthIn))
                    if showLabels
                        array.push(hLbls, label.new(bar_index, hiVal, str.tostring(n) + "h", style = label.style_label_left, size = labelSize, textcolor = colorUp, color = color.new(color.white, 100)))
                if loVal < close
                    array.push(hLines, line.new(bar_index - lineLenBars, loVal, bar_index, loVal, color = colorDown, width = lineWidthIn))
                    if showLabels
                        array.push(hLbls, label.new(bar_index, loVal, str.tostring(n) + "h", style = label.style_label_left, size = labelSize, textcolor = colorDown, color = color.new(color.white, 100)))

    // --- Diarios ---
    if showDaily
        dSz = array.size(dHighArr)
        for n = 1 to N_DAILY
            if dSz >= n
                hiVal = array.max(array.slice(dHighArr, dSz - n, dSz))
                loVal = array.min(array.slice(dLowArr,  dSz - n, dSz))
                if hiVal > close
                    array.push(dLines, line.new(bar_index - lineLenBars, hiVal, bar_index, hiVal, color = colorUp, width = lineWidthIn))
                    if showLabels
                        array.push(dLbls, label.new(bar_index, hiVal, str.tostring(n) + "D", style = label.style_label_left, size = labelSize, textcolor = colorUp, color = color.new(color.white, 100)))
                if loVal < close
                    array.push(dLines, line.new(bar_index - lineLenBars, loVal, bar_index, loVal, color = colorDown, width = lineWidthIn))
                    if showLabels
                        array.push(dLbls, label.new(bar_index, loVal, str.tostring(n) + "D", style = label.style_label_left, size = labelSize, textcolor = colorDown, color = color.new(color.white, 100)))

    // --- Semanales ---
    if showWeekly
        wSz = array.size(wHighArr)
        for n = 1 to N_WEEKLY
            if wSz >= n
                hiVal = array.max(array.slice(wHighArr, wSz - n, wSz))
                loVal = array.min(array.slice(wLowArr,  wSz - n, wSz))
                if hiVal > close
                    array.push(wLines, line.new(bar_index - lineLenBars, hiVal, bar_index, hiVal, color = colorUp, width = lineWidthIn))
                    if showLabels
                        array.push(wLbls, label.new(bar_index, hiVal, str.tostring(n) + "W", style = label.style_label_left, size = labelSize, textcolor = colorUp, color = color.new(color.white, 100)))
                if loVal < close
                    array.push(wLines, line.new(bar_index - lineLenBars, loVal, bar_index, loVal, color = colorDown, width = lineWidthIn))
                    if showLabels
                        array.push(wLbls, label.new(bar_index, loVal, str.tostring(n) + "W", style = label.style_label_left, size = labelSize, textcolor = colorDown, color = color.new(color.white, 100)))

    // --- Mensuales ---
    if showMonthly
        mSz = array.size(mHighArr)
        for n = 1 to N_MONTHLY
            if mSz >= n
                hiVal = array.max(array.slice(mHighArr, mSz - n, mSz))
                loVal = array.min(array.slice(mLowArr,  mSz - n, mSz))
                if hiVal > close
                    array.push(mLines, line.new(bar_index - lineLenBars, hiVal, bar_index, hiVal, color = colorUp, width = lineWidthIn))
                    if showLabels
                        array.push(mLbls, label.new(bar_index, hiVal, str.tostring(n) + "M", style = label.style_label_left, size = labelSize, textcolor = colorUp, color = color.new(color.white, 100)))
                if loVal < close
                    array.push(mLines, line.new(bar_index - lineLenBars, loVal, bar_index, loVal, color = colorDown, width = lineWidthIn))
                    if showLabels
                        array.push(mLbls, label.new(bar_index, loVal, str.tostring(n) + "M", style = label.style_label_left, size = labelSize, textcolor = colorDown, color = color.new(color.white, 100)))
