//@version=6

// =============================================================================
// CRT Multi-Timeframe Power of Three
//
// Modelo: rango HTF -> manipulacion (barrido + cierre dentro) -> alineacion
// en TF intermedio -> patron "power of three" (manipulacion + ruptura del
// ultimo swing) en el TF de entrada.
//
// Ejecutar SIEMPRE en el grafico del TF de entrada (por defecto 5m). El HTF
// y el TF intermedio se leen via request.security() con lookahead_off, y
// solo se re-evaluan en el cierre de su propia vela: cero repintado.
// =============================================================================

indicator("CRT Multi-TF Power of Three", overlay = true, max_lines_count = 300, max_labels_count = 300, max_boxes_count = 50)

// ------------------------------- INPUTS -------------------------------------

grpTF   = "Timeframes"
htfTF   = input.timeframe("240", "HTF (rango madre)", group = grpTF, tooltip = "4h tipico para forex, 8h tipico para XAUUSD.")
midTF   = input.timeframe("30",  "TF intermedio (estructura)", group = grpTF)
swingLen = input.int(2, "Pivote de entrada: velas a cada lado", minval = 1, group = grpTF, tooltip = "El grafico debe estar en el TF de entrada (5m por defecto).")

grpManip = "Manipulacion / ATR"
atrLen           = input.int(14, "Longitud ATR", minval = 1, group = grpManip)
manipMinATR_HTF  = input.float(0.20, "Penetracion minima HTF (x ATR HTF)", minval = 0.0, step = 0.05, group = grpManip)
manipMinATR_Mid  = input.float(0.20, "Penetracion minima TF intermedio (x ATR intermedio)", minval = 0.0, step = 0.05, group = grpManip)
qualityMult      = input.float(1.5, "Umbral para calidad A+ (x del minimo exigido)", minval = 1.0, step = 0.1, group = grpManip)

grpRisk = "Gestion (SL / TP)"
slBufferMult  = input.float(0.25, "Buffer de SL (x ATR entrada)", minval = 0.0, step = 0.05, group = grpRisk)
usePartialTP  = input.bool(true, "Marcar TP parcial en extremo del rango intermedio", group = grpRisk)

grpVis = "Visual"
showRanges = input.bool(true, "Dibujar rango HTF / intermedio", group = grpVis)
showStats  = input.bool(true, "Mostrar tabla de estadisticas", group = grpVis)

// ------------------------------- HTF: rango y sesgo --------------------------

[htfHighC, htfLowC, htfCloseC, htfHighP, htfLowP, htfTimeC, htfATR] = request.security(
     syminfo.tickerid, htfTF,
     [high[1], low[1], close[1], high[2], low[2], time[1], ta.atr(atrLen)[1]],
     lookahead = barmerge.lookahead_off)

newHTFBar = ta.change(htfTimeC) != 0

var int   htfBias            = 0
var float htfManipExtreme    = na
var float htfTargetExtreme   = na
var float htfRangeHigh       = na
var float htfRangeLow        = na
var float htfManipStrength   = na
var box   htfBox             = na

// ------------------------------- TF intermedio: rango y sesgo ----------------

[midHighC, midLowC, midCloseC, midHighP, midLowP, midTimeC, midATR] = request.security(
     syminfo.tickerid, midTF,
     [high[1], low[1], close[1], high[2], low[2], time[1], ta.atr(atrLen)[1]],
     lookahead = barmerge.lookahead_off)

newMidBar = ta.change(midTimeC) != 0

var int   midBias          = 0
var float midManipExtreme  = na
var float midTargetExtreme = na
var float midManipStrength = na
var box   midBox           = na

var int alignedSinceBar = na

// ------------------------------- Entrada (TF de grafico) ---------------------

var float lastSwingHigh   = na
var int   lastSwingHighBar = na
var bool  swingHighUsed   = true
var float pullbackLow     = na

var float lastSwingLow    = na
var int   lastSwingLowBar = na
var bool  swingLowUsed    = true
var float pullbackHigh    = na

atrEntry = ta.atr(atrLen)

// -------- 1) Nuevo cierre HTF: recalcular sesgo desde cero -------------------

if newHTFBar
    bool bullSweepHTF = (htfLowC < htfLowP - manipMinATR_HTF * htfATR) and (htfCloseC > htfLowP)
    bool bearSweepHTF = (htfHighC > htfHighP + manipMinATR_HTF * htfATR) and (htfCloseC < htfHighP)

    if bullSweepHTF and not bearSweepHTF
        htfBias := 1
        htfManipExtreme := htfLowC
        htfTargetExtreme := htfHighP
        htfManipStrength := (htfLowP - htfLowC) / (manipMinATR_HTF * htfATR)
    else if bearSweepHTF and not bullSweepHTF
        htfBias := -1
        htfManipExtreme := htfHighC
        htfTargetExtreme := htfLowP
        htfManipStrength := (htfHighC - htfHighP) / (manipMinATR_HTF * htfATR)
    else
        htfBias := 0
        htfManipExtreme := na
        htfTargetExtreme := na
        htfManipStrength := na

    htfRangeHigh := htfHighP
    htfRangeLow  := htfLowP

    // el sesgo se recalcula desde cero: cualquier alineacion intermedia
    // pendiente que no haya disparado entrada queda descartada
    midBias := 0
    midManipExtreme := na
    midTargetExtreme := na
    alignedSinceBar := na
    lastSwingHigh := na
    lastSwingLow := na
    swingHighUsed := true
    swingLowUsed := true

    if showRanges
        box.delete(htfBox)
        htfBox := box.new(bar_index, htfRangeHigh, bar_index + 1, htfRangeLow,
             border_color = color.new(color.gray, 40), bgcolor = color.new(color.gray, 92),
             extend = extend.right, xloc = xloc.bar_index)

// -------- 2) Nuevo cierre TF intermedio: recalcular sesgo y comprobar alineacion --

if newMidBar
    bool bullSweepMid = (midLowC < midLowP - manipMinATR_Mid * midATR) and (midCloseC > midLowP)
    bool bearSweepMid = (midHighC > midHighP + manipMinATR_Mid * midATR) and (midCloseC < midHighP)

    int newMidBias = bullSweepMid and not bearSweepMid ? 1 : (bearSweepMid and not bullSweepMid ? -1 : 0)
    midBias := newMidBias

    if newMidBias == 1
        midManipExtreme := midLowC
        midTargetExtreme := midHighP
        midManipStrength := (midLowP - midLowC) / (manipMinATR_Mid * midATR)
    else if newMidBias == -1
        midManipExtreme := midHighC
        midTargetExtreme := midLowP
        midManipStrength := (midHighC - midHighP) / (manipMinATR_Mid * midATR)
    else
        midManipExtreme := na
        midTargetExtreme := na
        midManipStrength := na

    bool alignedNow = htfBias != 0 and midBias == htfBias

    if alignedNow and na(alignedSinceBar)
        alignedSinceBar := bar_index
        lastSwingHigh := na
        lastSwingLow := na
        swingHighUsed := true
        swingLowUsed := true
    else if not alignedNow
        alignedSinceBar := na

    if showRanges
        box.delete(midBox)
        midBox := na
        if midBias != 0
            midBox := box.new(bar_index, midHighP, bar_index + 1, midLowP,
                 border_color = color.new(midBias == 1 ? color.teal : color.maroon, 30),
                 bgcolor = color.new(midBias == 1 ? color.teal : color.maroon, 90),
                 extend = extend.right, xloc = xloc.bar_index)

bool aligned = htfBias != 0 and midBias == htfBias and not na(alignedSinceBar)

// -------- 3) Pivotes de entrada (objetivos, N velas a cada lado) -------------

ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

bool justArmedHigh = false
if not na(ph)
    int peakBar = bar_index - swingLen
    if aligned and htfBias == 1 and peakBar >= alignedSinceBar
        lastSwingHigh := ph
        lastSwingHighBar := peakBar
        swingHighUsed := false
        pullbackLow := ta.lowest(low, swingLen)
        justArmedHigh := true

if not justArmedHigh and not na(lastSwingHigh) and not swingHighUsed
    pullbackLow := math.min(pullbackLow, low)

bool justArmedLow = false
if not na(pl)
    int troughBar = bar_index - swingLen
    if aligned and htfBias == -1 and troughBar >= alignedSinceBar
        lastSwingLow := pl
        lastSwingLowBar := troughBar
        swingLowUsed := false
        pullbackHigh := ta.highest(high, swingLen)
        justArmedLow := true

if not justArmedLow and not na(lastSwingLow) and not swingLowUsed
    pullbackHigh := math.max(pullbackHigh, high)

// -------- 4) Gatillo de entrada: ruptura del swing, solo en vela cerrada -----

bool longTrigger  = false
bool shortTrigger = false

float entryPrice = na
float slPrice = na
float tpPrice = na
float partialPrice = na
string quality = na

if barstate.isconfirmed
    if aligned and htfBias == 1 and not swingHighUsed and not na(lastSwingHigh) and lastSwingHighBar >= alignedSinceBar
        if close > lastSwingHigh and not na(htfManipExtreme) and pullbackLow > htfManipExtreme
            longTrigger := true
            entryPrice := close
            slPrice := pullbackLow - atrEntry * slBufferMult
            tpPrice := htfTargetExtreme
            partialPrice := usePartialTP ? midTargetExtreme : na
            quality := (htfManipStrength >= qualityMult and midManipStrength >= qualityMult) ? "A+" : "B"
            swingHighUsed := true

    if aligned and htfBias == -1 and not swingLowUsed and not na(lastSwingLow) and lastSwingLowBar >= alignedSinceBar
        if close < lastSwingLow and not na(htfManipExtreme) and pullbackHigh < htfManipExtreme
            shortTrigger := true
            entryPrice := close
            slPrice := pullbackHigh + atrEntry * slBufferMult
            tpPrice := htfTargetExtreme
            partialPrice := usePartialTP ? midTargetExtreme : na
            quality := (htfManipStrength >= qualityMult and midManipStrength >= qualityMult) ? "A+" : "B"
            swingLowUsed := true

// ------------------------------- Visual: etiquetas y niveles ------------------

if longTrigger
    label.new(bar_index, low, "LONG " + quality, style = label.style_label_up,
         color = quality == "A+" ? color.new(color.green, 0) : color.new(color.green, 55),
         textcolor = color.white, size = size.small, yloc = yloc.belowbar)
    line.new(bar_index, entryPrice, bar_index + 5, entryPrice, color = color.new(color.blue, 30), style = line.style_dashed)
    if usePartialTP and not na(partialPrice)
        line.new(bar_index, partialPrice, bar_index + 5, partialPrice, color = color.new(color.lime, 40), style = line.style_dotted)

if shortTrigger
    label.new(bar_index, high, "SHORT " + quality, style = label.style_label_down,
         color = quality == "A+" ? color.new(color.red, 0) : color.new(color.red, 55),
         textcolor = color.white, size = size.small, yloc = yloc.abovebar)
    line.new(bar_index, entryPrice, bar_index + 5, entryPrice, color = color.new(color.blue, 30), style = line.style_dashed)
    if usePartialTP and not na(partialPrice)
        line.new(bar_index, partialPrice, bar_index + 5, partialPrice, color = color.new(color.lime, 40), style = line.style_dotted)

// ------------------------------- Registro para validar efectividad -----------
// Las rayas de SL/TP se "congelan" en la vela donde se resuelven (o siguen
// hasta la vela actual mientras la señal sigue abierta), para poder revisar
// el resultado histórico de cada señal sin que el gráfico se sature.

var array<int>    logBar     = array.new<int>()
var array<int>    logDir     = array.new<int>()   // 1 long, -1 short
var array<float>  logEntry   = array.new<float>()
var array<float>  logSL      = array.new<float>()
var array<float>  logTP      = array.new<float>()
var array<string> logQuality = array.new<string>()
var array<string> logStatus  = array.new<string>() // "OPEN" | "TP" | "SL"
var array<line>   logLineSL  = array.new<line>()
var array<line>   logLineTP  = array.new<line>()

if longTrigger or shortTrigger
    array.push(logBar, bar_index)
    array.push(logDir, longTrigger ? 1 : -1)
    array.push(logEntry, entryPrice)
    array.push(logSL, slPrice)
    array.push(logTP, tpPrice)
    array.push(logQuality, quality)
    array.push(logStatus, "OPEN")
    array.push(logLineSL, line.new(bar_index, slPrice, bar_index, slPrice, color = color.new(color.red, 20)))
    array.push(logLineTP, line.new(bar_index, tpPrice, bar_index, tpPrice, color = color.new(color.green, 20)))

if barstate.isconfirmed and array.size(logStatus) > 0
    for i = 0 to array.size(logStatus) - 1
        if array.get(logStatus, i) == "OPEN"
            int dir = array.get(logDir, i)
            float sl = array.get(logSL, i)
            float tp = array.get(logTP, i)
            line.set_x2(array.get(logLineSL, i), bar_index)
            line.set_x2(array.get(logLineTP, i), bar_index)
            if dir == 1
                if low <= sl
                    array.set(logStatus, i, "SL")
                else if high >= tp
                    array.set(logStatus, i, "TP")
            else
                if high >= sl
                    array.set(logStatus, i, "SL")
                else if low <= tp
                    array.set(logStatus, i, "TP")

// ------------------------------- Tabla de estadisticas ------------------------

if showStats and barstate.islast
    var table statsTable = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 75), border_width = 1)

    int total = array.size(logStatus)
    int wins = 0
    int losses = 0
    int openCount = 0
    if total > 0
        for i = 0 to total - 1
            string st = array.get(logStatus, i)
            if st == "TP"
                wins += 1
            else if st == "SL"
                losses += 1
            else
                openCount += 1
    int closed = wins + losses
    float winRate = closed > 0 ? (wins / closed) * 100.0 : na

    table.cell(statsTable, 0, 0, "Sesgo HTF", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 0, htfBias == 1 ? "ALCISTA" : htfBias == -1 ? "BAJISTA" : "-", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 0, 1, "Sesgo intermedio", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 1, midBias == 1 ? "ALCISTA" : midBias == -1 ? "BAJISTA" : "-", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 0, 2, "Alineado", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 2, aligned ? "SI" : "NO", text_color = aligned ? color.lime : color.gray, text_size = size.small)
    table.cell(statsTable, 0, 3, "Señales totales", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 3, str.tostring(total), text_color = color.white, text_size = size.small)
    table.cell(statsTable, 0, 4, "TP / SL / Abiertas", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 4, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(openCount), text_color = color.white, text_size = size.small)
    table.cell(statsTable, 0, 5, "Win rate (cerradas)", text_color = color.white, text_size = size.small)
    table.cell(statsTable, 1, 5, na(winRate) ? "-" : str.tostring(winRate, "#.#") + "%", text_color = color.white, text_size = size.small)

// ------------------------------- Alertas ---------------------------------------

alertcondition(longTrigger, title = "CRT LONG", message = "CRT Multi-TF: senal de COMPRA confirmada")
alertcondition(shortTrigger, title = "CRT SHORT", message = "CRT Multi-TF: senal de VENTA confirmada")
