# Variables de entorno requeridas para ejecutar apps/web contra un proyecto
# Supabase real (implementation/mvp-0.1.md). Copia este archivo a .env.local
# y rellena con los valores de tu proyecto — nunca comites .env.local.

# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service_role key NUNCA debe configurarse aquí ni exponerse al cliente
# (implementation/mvp-0.1.md §13, riesgo técnico #3) — este proyecto no la usa
# en ningún punto del código.
