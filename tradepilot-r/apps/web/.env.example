# Variables de entorno requeridas para ejecutar apps/web contra un proyecto
# Supabase real (implementation/mvp-0.1.md). Copia este archivo a .env.local
# y rellena con los valores de tu proyecto — nunca comites .env.local.

# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen canónico de la web: esquema + dominio (+ puerto), sin ruta ni barra
# final. Con él se construye el enlace mágico de acceso; nunca se toma de las
# cabeceras de la petición. Es una variable de SERVIDOR: no lleva NEXT_PUBLIC_.
#   - Producción (Netlify/Vercel, `next start`): OBLIGATORIA. Debe ser https y
#     coincidir con la Site URL / Redirect URLs de Supabase Auth (sin comodines).
#     Sin ella la página de acceso no envía enlaces.
#   - Desarrollo (`next dev`, Abrir_TradePilot.bat): opcional; si falta se usa
#     http://localhost:3000. http solo se admite en localhost/127.0.0.1.
TP_SITE_URL=

# La service_role key NUNCA debe configurarse aquí ni exponerse al cliente
# (implementation/mvp-0.1.md §13, riesgo técnico #3) — este proyecto no la usa
# en ningún punto del código.
